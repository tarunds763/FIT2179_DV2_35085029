{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Four Invaders, One Continent (Introduced Since 1788)",
    "subtitle": "Confirmed sightings from the Atlas of Living Australia. Each panel shows a different invasive species.",
    "fontSize": 16,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "anchor": "start",
    "font": "Source Sans 3",
    "subtitleFont": "Source Sans 3",
    "color": "#172A39",
    "subtitleColor": "#6E7575"
  },
  "columns": 2,
  "concat": [
    {
      "title": {
        "text": "Feral Cat",
        "fontSize": 13,
        "fontWeight": "bold",
        "font": "Source Sans 3",
        "color": "#172A39"
      },
      "width": 300,
      "height": 220,
      "projection": {
        "type": "mercator"
      },
      "layer": [
        {
          "data": {
            "url": "data/australia-states.json"
          },
          "format": {
            "type": "json",
            "property": "features"
          },
          "mark": {
            "type": "geoshape",
            "fill": "#E9E4E0",
            "stroke": "#CFCAC5",
            "strokeWidth": 0.8
          }
        },
        {
          "data": {
            "url": "data/feral_cat_trimmed.csv"
          },
          "mark": {
            "type": "circle",
            "opacity": 0.22,
            "size": 4,
            "color": "#B85C3E"
          },
          "encoding": {
            "longitude": {
              "field": "decimalLongitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "decimalLatitude",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "stateProvince",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "year",
                "type": "quantitative",
                "title": "Year Recorded"
              }
            ]
          }
        }
      ]
    },
    {
      "title": {
        "text": "European Rabbit",
        "fontSize": 13,
