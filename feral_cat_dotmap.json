{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Feral Cats: A Continent-Wide Crisis (Since 1788)",
    "subtitle": "Confirmed sightings from the Atlas of Living Australia. Use the slider to trace the accumulation of records over time.",
    "fontSize": 16,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "anchor": "start",
    "font": "Source Sans 3",
    "subtitleFont": "Source Sans 3",
    "color": "#172A39",
    "subtitleColor": "#6E7575"
  },
  "width": 620,
  "height": 450,
  "projection": {
    "type": "mercator"
  },
  "params": [
    {
      "name": "yearMax",
      "value": 2023,
      "bind": {
        "input": "range",
        "min": 1970,
        "max": 2023,
        "step": 1,
        "name": "Show sightings up to: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/australia-states.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E9E4E0",
        "stroke": "#CFCAC5",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/feral_cat_trimmed.csv"
      },
      "transform": [
        {
          "filter": "datum.year != null && datum.year <= yearMax"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.24,
        "size": 7,
        "color": "#B85C3E"
      },
      "encoding": {
        "longitude": {
          "field": "decimalLongitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "decimalLatitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "stateProvince",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year Recorded"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "No state is untouched.",
            "lon": 128.5,
            "lat": -25.5
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "font": "Source Sans 3",
        "color": "#172A39",
        "align": "left"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Source Sans 3",
    "background": null
  }
}
