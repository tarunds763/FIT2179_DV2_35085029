{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Active Invasive Species Management by State",
    "subtitle": "Percentage of state area covered by active invasive species control programs",
    "fontSize": 16,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "anchor": "start",
    "font": "Source Sans 3",
    "subtitleFont": "Source Sans 3"
  },
  "width": 600,
  "height": 460,
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {
  "url": "data/australia-states.json",
  "format": {"type": "json", "property": "features"}
},
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {"url": "data/management_coverage.csv"},
            "key": "state",
            "fields": ["coverage_pct", "programs", "area_managed_km2"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "#C8C4B6", "strokeWidth": 0.8},
      "encoding": {
        "color": {
          "field": "coverage_pct",
          "type": "quantitative",
          "scale": {
            "range": ["#FFF3EE", "#FDDCB5", "#D85A30", "#7B1D00"],
            "domain": [0, 100]
          },
          "legend": {
            "title": "Coverage (%)",
            "orient": "right",
            "titleFont": "Source Sans 3",
            "labelFont": "Source Sans 3",
            "titleFontSize": 11,
            "labelFontSize": 11,
            "gradientLength": 120
          }
        },
        "tooltip": [
          {"field": "properties.STATE_NAME", "type": "nominal",      "title": "State"},
          {"field": "coverage_pct",          "type": "quantitative", "title": "Coverage (%)"},
          {"field": "programs",              "type": "quantitative", "title": "Active Programs"},
          {"field": "area_managed_km2",      "type": "quantitative", "title": "Area Managed (km²)", "format": ","}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"lon": 118.0, "lat": -28.0, "label": "Large states remain\nunder-managed."}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "font": "Source Sans 3",
        "color": "#7B1D00",
        "align": "left",
        "lineBreak": "\n"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude":  {"field": "lat", "type": "quantitative"},
        "text":      {"field": "label", "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Source Sans 3"
  }
}