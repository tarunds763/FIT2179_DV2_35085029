{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "title": {
    "text": "Threatened Species Across Australian States",
    "subtitle": "Number of threatened species recorded per state.",
    "fontSize": 16,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "anchor": "start",
    "font": "Source Sans 3",
    "subtitleFont": "Source Sans 3",
    "color": "#1F2D3D",
    "subtitleColor": "#6B6B65",
    "offset": 10
  },
  "width": 620,
  "height": 420,
  "projection": {
    "type": "mercator"
  },
  "config": {
    "view": {
      "stroke": null
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/australia-states.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "url": "data/epbc_state_counts.csv"
            },
            "key": "state",
            "fields": ["count"]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FAFAF7",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "count",
          "type": "quantitative",
          "scale": {
            "domain": [0, 760],
            "range": ["#D9D5CF", "#BFC4C2", "#8E989A", "#5F6A6D", "#19324A"]
          },
          "legend": {
            "title": "Threatened Species",
            "orient": "bottom-right",
            "gradientLength": 135,
            "gradientThickness": 14,
            "labelColor": "#4B4B46",
            "titleColor": "#1A1A18",
            "titleFont": "Source Sans 3",
            "labelFont": "Source Sans 3",
            "offset": 36
          }
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Threatened Species"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "NSW: 760",
            "longitude": 146.5,
            "latitude": -32.6
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Source Sans 3",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#FAFAF7",
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 149.13,
            "latitude": -35.28
          }
        ]
      },
      "mark": {
        "type": "circle",
        "size": 28,
        "filled": true,
        "color": "#C9785C",
        "stroke": "#FAFAF7",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x1": 149.22,
            "y1": -35.32,
            "x2": 151.55,
            "y2": -36.08
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#C9785C",
        "strokeWidth": 1.1
      },
      "encoding": {
        "longitude": {
          "field": "x1",
          "type": "quantitative"
        },
        "latitude": {
          "field": "y1",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "x2"
        },
        "latitude2": {
          "field": "y2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "ACT: 71",
            "longitude": 151.9,
            "latitude": -36.1
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Source Sans 3",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#1A1A18",
        "align": "left",
        "baseline": "middle",
        "dx": 6
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ]
}
