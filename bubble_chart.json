{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
        "text": "The Price of Invasion: Economic Cost by Species",
        "subtitle": "Estimated annual economic cost in 2017 USD. Bubble size and colour intensify with the scale of damage.",
        "fontSize": 18,
        "fontWeight": "bold",
        "subtitleFontSize": 12,
        "anchor": "start",
        "font": "Source Sans 3",
        "subtitleFont": "Source Sans 3",
        "color": "#1A1A18",
        "subtitleColor": "#6B6B65",
        "offset": 14
    },
    "width": 410,
    "height": 320,
    "data": {
        "url": "data/invacost_bubble.csv"
    },
    "layer": [
        {
            "mark": {
                "type": "circle",
                "opacity": 0.92,
                "stroke": "#F6F2EB",
                "strokeWidth": 2.2
            },
            "encoding": {
                "x": {
                    "field": "common_name",
                    "type": "nominal",
                    "sort": "-y",
                    "axis": {
                        "title": null,
                        "labelAngle": -26,
                        "labelFontSize": 11,
                        "labelFont": "Source Sans 3",
                        "labelColor": "#3A3A36",
                        "labelPadding": 12,
                        "ticks": true,
                        "tickColor": "#948A80",
                        "tickSize": 5,
                        "domainColor": "#948A80",
                        "domainWidth": 1.2,
                        "grid": false
                    }
                },
                "y": {
                    "field": "cost_billions",
                    "type": "quantitative",
                    "scale": {
                        "domain": [
                            0,
                            4.9
                        ]
                    },
                    "axis": {
                        "title": "Cost per Year (USD billions, 2017)",
                        "titleFont": "Source Sans 3",
                        "titleFontSize": 12,
                        "titleColor": "#1A1A18",
                        "titlePadding": 12,
                        "labelFont": "Source Sans 3",
                        "labelFontSize": 11,
                        "labelColor": "#3A3A36",
                        "grid": true,
                        "gridColor": "#E5DED5",
                        "gridDash": [
                            3,
                            4
                        ],
                        "gridOpacity": 0.75,
                        "tickColor": "#948A80",
                        "domain": false,
                        "values": [
                            0,
                            1,
                            2,
                            3,
                            4,
                            5
                        ]
                    }
                },
                "size": {
                    "field": "cost_billions",
                    "type": "quantitative",
                    "scale": {
                        "range": [140, 1800]
                    },
                    "legend": null
                },
                "color": {
                    "field": "cost_billions",
                    "type": "quantitative",
                    "scale": {
                        "domain": [
                            0,
                            4.1
                        ],
                        "range": [
                            "#D8A978",
                            "#C97C4B",
                            "#A85636",
                            "#7B1D00"
                        ]
                    },
                    "legend": null
                },
                "tooltip": [
                    {
                        "field": "common_name",
                        "type": "nominal",
                        "title": "Species"
                    },
                    {
                        "field": "cost_billions",
                        "type": "quantitative",
                        "title": "Cost per Year (USD bn)",
                        "format": ".3f"
                    },
                    {
                        "field": "dominant_sector",
                        "type": "nominal",
                        "title": "Primary Sector Affected"
                    }
                ]
            }
        },
        {
            "transform": [
                {
                    "filter": "datum.common_name === 'Feral Cat'"
                }
            ],
            "mark": {
                "type": "text",
                "fontSize": 11,
                "font": "Source Sans 3",
                "fontWeight": 600,
                "fontStyle": "italic",
                "color": "#7B1D00",
                "align": "left",
                "baseline": "middle",
                "dx": 28,
                "dy": 0
            },
            "encoding": {
                "x": {
                    "field": "common_name",
                    "type": "nominal",
                    "sort": "-y"
                },
                "y": {
                    "field": "cost_billions",
                    "type": "quantitative"
                },
                "text": {
                    "value": "<- Highest annual cost"
                }
            }
        }
    ],
    "config": {
        "view": {
            "stroke": null
        },
        "font": "Source Sans 3",
        "background": null
    }
}