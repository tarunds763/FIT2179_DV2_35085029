          "legend": {
            "title": "Species Threatened",
            "orient": "bottom",
            "direction": "horizontal",
            "values": [20, 100, 200, 322]
          }
        },
        "color": {
          "field": "threatened",
          "type": "quantitative",
          "scale": {
            "range": ["#FDDCB5", "#D85A30", "#7B1D00"],
            "domain": [0, 322]
          },
          "legend": null
        },
        "tooltip": [
