          {"field": "year",       "type": "quantitative", "title": "Year Introduced"},
          {"field": "origin",     "type": "nominal",      "title": "Origin"},
          {"field": "threatened", "type": "quantitative", "title": "Species Threatened"},
          {"field": "reason",     "type": "nominal",      "title": "Why Introduced"}
        ]
