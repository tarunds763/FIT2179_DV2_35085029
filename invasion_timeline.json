          {"species": "Feral Cat",    "year": 1788, "threatened": 123, "origin": "Europe",        "reason": "Brought as domestic pets by settlers"},
          {"species": "Black Rat",    "year": 1788, "threatened": 20,  "origin": "Asia",          "reason": "Arrived on First Fleet ships"},
          {"species": "Feral Pig",    "year": 1800, "threatened": 40,  "origin": "Europe",        "reason": "Brought as livestock, escaped into wild"},
          {"species": "Feral Goat",   "year": 1840, "threatened": 35,  "origin": "Europe",        "reason": "Released from pastoral stations"},
          {"species": "Euro. Rabbit", "year": 1859, "threatened": 322, "origin": "Europe",        "reason": "Released for sport hunting in Victoria"},
          {"species": "Common Myna",  "year": 1862, "threatened": 15,  "origin": "Asia",          "reason": "Introduced to control insects in Melbourne"},
          {"species": "Red Fox",      "year": 1871, "threatened": 99,  "origin": "Europe",        "reason": "Released for recreational fox hunting"},
          {"species": "Cane Toad",    "year": 1935, "threatened": 55,  "origin": "South America", "reason": "Deliberately introduced to control beetles"},
          {"species": "Euro. Wasp",   "year": 1977, "threatened": 10,  "origin": "Europe",        "reason": "Accidentally introduced via cargo"}
